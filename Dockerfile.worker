# Scan worker image. Built from the official Playwright image (Chromium + all
# system deps preinstalled, matching the playwright npm version). Build context
# is the repo root so workspace packages (@accessaudit/shared, /database) resolve.
#
#   docker build -f Dockerfile.worker -t accessaudit-worker .
#   docker run --rm -e SUPABASE_URL=... -e SUPABASE_SERVICE_ROLE_KEY=... accessaudit-worker

FROM mcr.microsoft.com/playwright:v1.60.0-noble

WORKDIR /app
ENV NODE_ENV=production

# pnpm via corepack, pinned to the repo's version.
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate

# Install deps first for layer caching (manifests only).
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY packages/shared/package.json   packages/shared/
COPY packages/database/package.json packages/database/
COPY apps/worker/package.json       apps/worker/
RUN pnpm install --frozen-lockfile --filter @accessaudit/worker...

# App source.
COPY packages/shared   packages/shared
COPY packages/database packages/database
COPY apps/worker       apps/worker

# Ensure the Chromium build matching the resolved playwright version is present.
# Installs into /ms-playwright (the base image's PLAYWRIGHT_BROWSERS_PATH), which
# the non-root pwuser can read.
RUN pnpm --filter @accessaudit/worker exec playwright install chromium

# Fail the image build on any type error rather than discovering it at runtime.
RUN pnpm --filter @accessaudit/worker typecheck

# Drop privileges. The worker renders arbitrary customer-supplied URLs in Chromium
# (with --no-sandbox), so a renderer escape must NOT land as root. pwuser ships in
# the Playwright base image.
RUN chown -R pwuser:pwuser /app
USER pwuser

CMD ["pnpm", "--filter", "@accessaudit/worker", "start"]
