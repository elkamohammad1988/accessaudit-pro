# =============================================================================
# AccessAudit Pro — environment variables
# Copy to .env.local (git-ignored) and fill in:  cp .env.example .env.local
#
# This ONE root file is loaded for BOTH apps in local dev (Turborepo):
#   - apps/web    via apps/web/next.config.mjs  -> scripts/load-env.mjs
#   - apps/worker via apps/worker/src/load-env.ts (imported first in index.ts)
# In production each service gets these from its host's env (Vercel / Railway),
# not from this file.
#
# Browser-exposed vars are prefixed NEXT_PUBLIC_; everything else is server-only
# and must never be shipped to the client.
#
# Mandatory for local dev:  Supabase (URL + anon + service-role keys).
# Optional / mockable:       Stripe (billing) and Sentry (errors) — the app boots
#                            and scans run without them; placeholders are fine.
# See docs/DEPLOYMENT.md for the go-live walkthrough.
# =============================================================================

# ---- Supabase (web app: client + server) -----------------------------------
# Local stack defaults (from `supabase start`). Swap for your hosted project ref
# when deploying. The anon key is safe to expose; the service-role key is NOT.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<local-anon-key-from-`supabase start`>"

# ---- Server-only -----------------------------------------------------------
# Used by Route Handlers (CSV export, Stripe webhook) and the worker. Bypasses
# RLS — keep secret, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY="<local-service-role-key-from-`supabase start`>"

# ---- App -------------------------------------------------------------------
# Public base URL; used to build share links and Stripe return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Scan worker (apps/worker) ---------------------------------------------
# The worker is a separate process (Railway). It uses the NON-public URL var and
# the same SUPABASE_SERVICE_ROLE_KEY as above (set both in the worker's env).
SUPABASE_URL="http://127.0.0.1:54321"
# Tuning (defaults shown). All optional.
# WORKER_POLL_INTERVAL_MS="3000"      # queue poll cadence
# WORKER_PAGE_TIMEOUT_MS="30000"      # per-page navigation + axe analysis timeout
# WORKER_SETTLE_MS="5000"             # bounded network-idle wait before axe runs
# WORKER_MAX_NODES="5"                # max element snippets stored per violation
# WORKER_STALE_SCAN_MS="1800000"      # reaper threshold: requeue/fail scans idle this long
# WORKER_SCAN_CONCURRENCY="3"         # pages scanned in parallel within one scan
# WORKER_MAX_ATTEMPTS="3"             # claims before a scan is dead-lettered to failed
# WORKER_RECYCLE_AFTER_PAGES="200"    # relaunch Chromium after N pages (bounds memory)
# WORKER_HEALTH_PORT="8080"           # /health + /metrics HTTP port (0 disables)

# ---- Stripe (billing) ------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# One monthly Stripe Price id per paid plan (create these in the Stripe dashboard).
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_AGENCY="price_..."
STRIPE_PRICE_SCALE="price_..."
# Annual Price ids (optional). Set ALL THREE to offer yearly billing (2 months
# free); if any is blank, the monthly/annual toggle is hidden and checkout stays
# monthly-only. Each must be a recurring/yearly Price for the SAME product.
STRIPE_PRICE_STARTER_ANNUAL="price_..."
STRIPE_PRICE_AGENCY_ANNUAL="price_..."
STRIPE_PRICE_SCALE_ANNUAL="price_..."

# ---- Observability (Sentry) — optional -------------------------------------
# Error tracking for the web app and the worker. Leave blank to disable: the
# Sentry SDK is only initialized when a DSN is present, so empty = no-op.
# Create a project at sentry.io and copy its DSN. The browser DSN must be
# NEXT_PUBLIC_ (it ships to the client); the server/worker read SENTRY_DSN.
# Using the same project for both is fine.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
