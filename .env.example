# =============================================================================
# AccessAudit Pro — environment variables
# Copy to .env.local (git-ignored) and fill in. Browser-exposed vars are
# prefixed NEXT_PUBLIC_; everything else is server-only and must never be
# shipped to the client. See docs/DEPLOYMENT.md for the go-live walkthrough.
# =============================================================================

# ---- Supabase (web app: client + server) -----------------------------------
# Local stack defaults (from `supabase start`). Swap for your hosted project ref
# when deploying. The anon key is safe to expose; the service-role key is NOT.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<local-anon-key-from-`supabase start`>"

# ---- Server-only -----------------------------------------------------------
# Used by Route Handlers (CSV export, Stripe webhook) and the worker. Bypasses
# RLS — keep secret, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY="<local-service-role-key-from-`supabase start`>"

# ---- App -------------------------------------------------------------------
# Public base URL; used to build share links and Stripe return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Scan worker (apps/worker) ---------------------------------------------
# The worker is a separate process (Railway). It uses the NON-public URL var.
SUPABASE_URL="http://127.0.0.1:54321"
# WORKER_POLL_INTERVAL_MS="3000"
# WORKER_PAGE_TIMEOUT_MS="30000"
# WORKER_MAX_NODES="5"

# ---- Stripe (billing) ------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# One Stripe Price id per paid plan (create these in the Stripe dashboard).
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_AGENCY="price_..."
STRIPE_PRICE_SCALE="price_..."
