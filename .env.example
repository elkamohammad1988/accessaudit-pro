# =============================================================================
# AccessAudit Pro — environment variables
# Copy to .env.local (git-ignored) and fill in. Browser-exposed vars are
# prefixed NEXT_PUBLIC_; everything else is server-only and must never be
# shipped to the client.
# =============================================================================

# ---- Supabase (client + server) --------------------------------------------
# Local stack defaults (from `supabase start`). Swap for your hosted project ref
# when deploying. The anon key is safe to expose; the service-role key is NOT.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<local-anon-key-from-`supabase start`>"

# ---- Server-only -----------------------------------------------------------
# Used by Route Handlers / the worker / the Stripe webhook. Bypasses RLS — keep secret.
SUPABASE_SERVICE_ROLE_KEY="<local-service-role-key-from-`supabase start`>"

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Stripe (added in the billing phase) -----------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
