{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_APP_URL",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PRICE_STARTER",
    "STRIPE_PRICE_AGENCY",
    "STRIPE_PRICE_SCALE",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
    "WORKER_POLL_INTERVAL_MS",
    "WORKER_PAGE_TIMEOUT_MS",
    "WORKER_MAX_NODES",
    "WORKER_STALE_SCAN_MS",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_DSN"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
