fetch-timeout=600000
fetch-retries=8
fetch-retry-maxtimeout=300000
fetch-retry-mintimeout=15000
network-concurrency=1
child-concurrency=1
# Don't run `pnpm install` before every `pnpm run <script>` (turbo dev, etc.).
# Avoids ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY when launching via turbo/npm.
verify-deps-before-run=false
