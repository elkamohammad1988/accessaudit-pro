{
  "name": "accessaudit-pro",
  "version": "0.1.0",
  "private": true,
  "description": "AccessAudit Pro — on-demand WCAG accessibility audits for agencies.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/database/src/types.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

